#!/usr/bin/env bash
# pre-commit hook — security guardrails
# Template source: ~/.openclaw/workspace-dev/_shared/pre-commit-template
# Copy to .githooks/pre-commit and run: git config core.hooksPath .githooks
#
# Checks:
#   1. .gitignore must contain a .env entry — aborts if missing
#   2. Staged files must not match *.env or .env.* (except .env.example) — aborts if found
#   3. Staged file contents must not contain common API key prefixes — loud warning if found

set -euo pipefail

RED='\033[0;31m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
RESET='\033[0m'

abort() {
  echo -e "\n${RED}${BOLD}✖ PRE-COMMIT BLOCKED${RESET}"
  echo -e "${RED}$1${RESET}\n"
  exit 1
}

warn() {
  echo -e "\n${YELLOW}${BOLD}⚠  PRE-COMMIT WARNING${RESET}"
  echo -e "${YELLOW}$1${RESET}\n"
}

# ──────────────────────────────────────────────
# 1. .gitignore must contain .env
# ──────────────────────────────────────────────
GITIGNORE=".gitignore"

if [ ! -f "$GITIGNORE" ]; then
  abort ".gitignore does not exist.\nCreate one and add '.env' before committing."
fi

if ! grep -qE '^\.env$|^\.env$|^/\.env$' "$GITIGNORE"; then
  abort ".gitignore exists but does not contain a '.env' entry.\nAdd the following line to .gitignore:\n\n  .env\n\nThen stage .gitignore and try again."
fi

# ──────────────────────────────────────────────
# 2. No staged *.env or .env.* files (except .env.example)
# ──────────────────────────────────────────────
BAD_ENV_FILES=$(git diff --cached --name-only | grep -E '(^|/)\.env\.[^/]+$|(^|/)[^/]+\.env$' | grep -v '\.env\.example$' || true)

if [ -n "$BAD_ENV_FILES" ]; then
  FILE_LIST=$(echo "$BAD_ENV_FILES" | sed 's/^/  • /')
  abort "Refusing to commit env files:\n\n${FILE_LIST}\n\nUnstage them with: git restore --staged <file>"
fi

# ──────────────────────────────────────────────
# 3. Scan staged content for API key patterns
# ──────────────────────────────────────────────
# Patterns: Anthropic (sk-ant-), OpenAI project keys (sk-proj-), GitHub tokens (ghp_, gho_)
KEY_PATTERNS='sk-ant-[A-Za-z0-9_-]{10,}|sk-proj-[A-Za-z0-9_-]{10,}|ghp_[A-Za-z0-9]{36,}|gho_[A-Za-z0-9]{36,}'

STAGED_FILES=$(git diff --cached --name-only)
MATCHES=""

if [ -n "$STAGED_FILES" ]; then
  while IFS= read -r file; do
    # Skip binary files
    if git show ":$file" 2>/dev/null | file - | grep -q 'binary'; then
      continue
    fi
    FOUND=$(git show ":$file" 2>/dev/null | grep -oE "$KEY_PATTERNS" | head -5 || true)
    if [ -n "$FOUND" ]; then
      MATCHES="${MATCHES}\n  • ${file}"
    fi
  done <<< "$STAGED_FILES"
fi

if [ -n "$MATCHES" ]; then
  warn "Possible API key(s) detected in staged files:${MATCHES}\n\n  Patterns matched: sk-ant-*, sk-proj-*, ghp_*, gho_*\n\n  Review these files. If intentional, you can bypass with:\n    git commit --no-verify\n  (NOT recommended unless you're certain these are test/dummy values.)"
fi

exit 0
